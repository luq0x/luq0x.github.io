---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { profile, certifications } from '../config';
import { url } from '../lib/path';
import { localeHref, locales, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = t(lang);
const [lead, ...bio] = s.bio;
const hasPhoto = existsSync(join(process.cwd(), 'public', profile.photo));
const photo = hasPhoto ? profile.photo : profile.avatar;

const langTargets = Object.fromEntries(
  locales.map((locale) => [locale, localeHref(locale, '/about')]),
) as Record<Locale, string>;
---

<BaseLayout
  lang={lang}
  title={`${s.aboutTitle} — ${s.siteTitle}`}
  description={s.aboutDescription}
  langTargets={langTargets}
>
  <h1 class="text-ink text-[1.375rem] font-bold"><span class="prompt">$</span> cat about.md</h1>

  <div class="mt-8 grid gap-8 sm:grid-cols-[12rem_minmax(0,1fr)]">
    <div>
      <img
        src={url(photo)}
        alt={profile.name}
        width="192"
        height="240"
        loading="eager"
        class="border-rule aspect-[4/5] w-full max-w-48 border object-cover grayscale transition hover:grayscale-0"
      />
      <p class="meta mt-2">{profile.name} · {profile.location}</p>
    </div>

    <div class="min-w-0">
      <p class="text-ink text-[1.0625rem] leading-[1.7] font-semibold text-pretty">{lead}</p>
      <div class="text-dim mt-5 space-y-4 leading-[1.85]">
        {bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>

  {
    certifications.length > 0 && (
      <section class="mt-12">
        <h2 class="h-section">
          <span>{s.certifications.toLowerCase()}</span>
        </h2>
        <ul class="mt-3 space-y-1">
          {certifications.map((cert) => (
            <li class="leader">
              <span class="text-ink">{cert.name}</span>
              <span class="meta">
                {cert.issuer} · {cert.year}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-12">
    <h2 class="h-section"><span>{s.contact.toLowerCase()}</span></h2>
    <SocialLinks lang={lang} class="mt-3" />
  </section>
</BaseLayout>
