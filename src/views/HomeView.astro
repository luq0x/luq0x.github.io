---
import BaseLayout from '../layouts/BaseLayout.astro';
import BinaryHero from '../components/BinaryHero.astro';
import BinaryRule from '../components/BinaryRule.astro';
import WriteupCard from '../components/WriteupCard.astro';
import BountyTicker from '../components/BountyTicker.astro';
import { profile, bounties } from '../config';
import { getWriteups } from '../lib/writeups';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = t(lang);
const writeups = await getWriteups(lang);
const latest = writeups.slice(0, 4);
---

<BaseLayout lang={lang} title={s.siteTitle}>
  <section class="pt-2">
    <h1 class="sr-only">{profile.name}</h1>
    <BinaryHero />

    <div class="mt-8 space-y-1.5">
      <p><span class="prompt">$</span> whoami</p>
      <p class="text-dim pl-4">{profile.name} — {s.tagline}</p>
      <p class="pt-3"><span class="prompt">$</span> cat README.md</p>
      <p class="text-dim max-w-[62ch] pl-4 text-pretty">{s.heroLead}</p>
      <p class="pt-3">
        <span class="prompt">$</span> ls
        <a href={localeHref(lang, '/writeups')} class="link ml-2">writeups/</a>
        <a href={localeHref(lang, '/about')} class="link ml-2">about.md</a>
      </p>
    </div>
  </section>

  <div class="mt-14"><BinaryRule /></div>

  {
    bounties.length > 0 && (
      <section class="mt-10" aria-labelledby="bounties">
        <h2 class="h-section">
          <span id="bounties">{s.latestBounties.toLowerCase()}</span>
          <span class="meta font-normal">{String(bounties.length).padStart(2, '0')}</span>
        </h2>
        <div class="-mx-6 mt-5 sm:mx-0">
          <BountyTicker />
        </div>
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="mt-14" aria-labelledby="latest">
        <h2 class="h-section">
          <span id="latest">{s.latestWriteups.toLowerCase()}</span>
          <a href={localeHref(lang, '/writeups')} class="more text-xs font-normal">
            {s.allWriteups.toLowerCase()} →
          </a>
        </h2>
        <div class="mt-4">
          {latest.map((entry) => (
            <WriteupCard entry={entry} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
