---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupCard from '../components/WriteupCard.astro';
import SeverityTag from '../components/SeverityTag.astro';
import RewardTag from '../components/RewardTag.astro';
import Tag from '../components/Tag.astro';
import Icon from '../components/Icon.astro';
import { profile, bounties, certifications } from '../config';
import { formatDate, isoDate } from '../lib/format';
import { getWriteups, readingTimeOf, slugOf } from '../lib/writeups';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = t(lang);
const writeups = await getWriteups(lang);
const [featured, ...rest] = writeups;
const more = rest.slice(0, 2);

const sinceYear = Math.min(
  ...bounties.map((bounty) => Number(bounty.date.slice(0, 4))),
  ...writeups.map((entry) => entry.data.pubDate.getUTCFullYear()),
);

const stats = [
  { value: bounties.length, label: s.statBounties, jp: '賞金' },
  { value: writeups.length, label: s.statWriteups, jp: '記録' },
  { value: certifications.length, label: s.statCerts, jp: '経歴' },
  { value: Number.isFinite(sinceYear) ? sinceYear : '—', label: s.statSince, jp: '研究' },
];

const pad = (value: number | string) =>
  typeof value === 'number' && value < 10 ? String(value).padStart(2, '0') : String(value);

const dot = (severity?: string) =>
  severity === 'Critical'
    ? 'bg-blood'
    : severity === 'High'
      ? 'bg-blood/60'
      : severity === 'Medium'
        ? 'bg-dim'
        : 'bg-hush/60';

const VISIBLE_BOUNTIES = 6;
---

<BaseLayout lang={lang} title={s.siteTitle} rail={s.railHome}>
  <!-- hero -->
  <section class="relative pt-4 pb-14 lg:pt-10 lg:pb-20">
    <span
      class="jp outline-text pointer-events-none absolute -top-2 right-0 hidden text-[150px] leading-none tracking-[0.05em] select-none md:block"
      aria-hidden="true"
    >
      闇
    </span>

    <p class="meta eyebrow text-blood">{s.tagline}</p>

    <h1 class="display text-ink mt-6 text-[72px] sm:text-[112px] lg:text-[136px]">
      {profile.name}<span
        class="bg-blood animate-blink ml-2 inline-block h-[0.72em] w-[0.14em] align-baseline"
        aria-hidden="true"></span>
    </h1>

    <p class="text-dim mt-8 max-w-[52ch] text-[17px] leading-relaxed text-pretty">{s.heroLead}</p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href={localeHref(lang, '/writeups')}
        class="group bg-blood text-void hover:bg-ink inline-flex items-center gap-2.5 px-5 py-3 text-[13.5px] font-medium transition-colors"
      >
        {s.ctaWriteups}
        <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
      <a
        href={localeHref(lang, '/about')}
        class="border-rule text-ink hover:border-blood hover:text-blood inline-flex items-center gap-2.5 border px-5 py-3 text-[13.5px] transition-colors"
      >
        {s.ctaAbout}
      </a>
    </div>
  </section>

  <!-- stats -->
  <section aria-label="Stats" class="border-rule grid grid-cols-2 border-y md:grid-cols-4">
    {
      stats.map((stat, index) => (
        <div
          class:list={[
            'border-rule relative px-4 py-6 sm:px-6',
            index % 2 === 1 && 'border-l',
            index >= 2 && 'border-t md:border-t-0',
            index === 2 && 'md:border-l',
          ]}
        >
          <span
            class="jp text-hush absolute top-3 right-3 text-[10px] tracking-[0.2em]"
            aria-hidden="true"
          >
            {stat.jp}
          </span>
          <p class="text-ink font-mono text-[34px] leading-none font-medium tracking-[-0.04em] tabular-nums sm:text-[40px]">
            {pad(stat.value)}
          </p>
          <p class="meta mt-3">{stat.label}</p>
        </div>
      ))
    }
  </section>

  <!-- writeups -->
  {
    featured && (
      <section class="mt-20" aria-labelledby="latest">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <div>
            <p class="meta text-blood">01</p>
            <h2 id="latest" class="text-ink mt-2 text-[26px] font-medium tracking-[-0.025em]">
              {s.latestWriteups}
            </h2>
          </div>
          <a
            href={localeHref(lang, '/writeups')}
            class="group meta hover:text-blood inline-flex items-center gap-2 transition-colors"
          >
            {s.allWriteups}
            <Icon name="arrow" class="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>

        <article class="group corners panel relative mt-8 grid overflow-hidden md:grid-cols-[1.15fr_1fr]">
          <div class="border-rule bg-raise relative aspect-[16/10] overflow-hidden border-b md:aspect-auto md:border-r md:border-b-0">
            {featured.data.cover ? (
              <Image
                src={featured.data.cover}
                alt={featured.data.coverAlt ?? ''}
                widths={[480, 768, 1024]}
                sizes="(min-width: 768px) 560px, 100vw"
                class="h-full w-full object-cover opacity-85 transition duration-500 group-hover:scale-[1.02] group-hover:opacity-100"
              />
            ) : (
              <div class="grid-bg flex h-full min-h-56 items-center justify-center opacity-60">
                <span class="jp text-hush text-[32px]">{s.railWriteups}</span>
              </div>
            )}
            <span class="bg-blood text-void absolute top-3 left-3 px-2 py-0.5 font-mono text-[10.5px] tracking-[0.1em] uppercase">
              {s.featured}
            </span>
          </div>

          <div class="flex flex-col p-5 sm:p-7">
            <div class="meta flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="text-ink">#{String(writeups.length).padStart(3, '0')}</span>
              <span class="slash">/</span>
              <time datetime={isoDate(featured.data.pubDate)}>
                {formatDate(featured.data.pubDate, lang)}
              </time>
              <span class="slash">/</span>
              <span>
                {readingTimeOf(featured)} {s.readingTime}
              </span>
            </div>

            <h3 class="text-ink group-hover:text-blood mt-4 text-[24px] leading-[1.2] font-medium tracking-[-0.025em] text-balance transition-colors sm:text-[28px]">
              <a href={localeHref(lang, `/writeups/${slugOf(featured)}`)} class="stretched">
                {featured.data.title}
              </a>
            </h3>

            <p class="text-dim mt-4 text-[14.5px] leading-relaxed">{featured.data.summary}</p>

            <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-7">
              <ul class="flex flex-wrap gap-1.5">
                {featured.data.severity && (
                  <li>
                    <SeverityTag severity={featured.data.severity} />
                  </li>
                )}
                {featured.data.reward && (
                  <li>
                    <RewardTag reward={featured.data.reward} />
                  </li>
                )}
                {featured.data.tags.map((tag) => (
                  <li>
                    <Tag name={tag} />
                  </li>
                ))}
              </ul>
              <Icon
                name="arrow"
                class="text-hush group-hover:text-blood h-5 w-5 -rotate-45 transition duration-200 group-hover:rotate-0"
              />
            </div>
          </div>
        </article>

        {more.length > 0 && (
          <div class="mt-4 space-y-4">
            {more.map((entry, index) => (
              <WriteupCard entry={entry} lang={lang} number={writeups.length - 1 - index} />
            ))}
          </div>
        )}
      </section>
    )
  }

  <!-- bounties -->
  {
    bounties.length > 0 && (
      <section class="mt-20" aria-labelledby="bounties">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <div>
            <p class="meta text-blood">{featured ? '02' : '01'}</p>
            <h2 id="bounties" class="text-ink mt-2 text-[26px] font-medium tracking-[-0.025em]">
              {s.latestBounties}
            </h2>
          </div>
          <span class="jp text-hush text-[12px]" aria-hidden="true">
            賞金
          </span>
        </div>

        <div class="panel mt-8 px-3 pt-2 pb-3 sm:px-5">
          <div class="log-row meta border-rule border-b border-solid text-[10px] hover:bg-transparent">
            <span>{s.colDate}</span>
            <span class="hidden sm:block">{s.colProgram}</span>
            <span>{s.colType}</span>
            <span class="text-right">{s.colReward}</span>
          </div>

          <ul data-bounty-list>
            {bounties.map((bounty, index) => (
              <li
                class="log-row"
                hidden={index >= VISIBLE_BOUNTIES}
                data-extra={index >= VISIBLE_BOUNTIES ? '' : undefined}
              >
                <span class="meta">{bounty.date}</span>
                <span class="text-ink hidden truncate font-mono text-[12.5px] sm:block">
                  {bounty.href ? (
                    <a href={bounty.href} target="_blank" rel="noopener" class="link-underline">
                      {bounty.program}
                    </a>
                  ) : (
                    bounty.program
                  )}
                </span>
                <span class="text-dim flex min-w-0 items-center gap-2.5 text-[13.5px]">
                  <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${dot(bounty.severity)}`} />
                  <span class="truncate">{bounty.type}</span>
                </span>
                <span class="text-blood text-right font-mono text-[13px] tabular-nums">
                  {bounty.reward}
                </span>
              </li>
            ))}
          </ul>

          {bounties.length > VISIBLE_BOUNTIES && (
            <button
              type="button"
              class="group/more meta hover:text-blood flex w-full items-center justify-center gap-2 pt-3.5 pb-1 transition-colors"
              aria-expanded="false"
              data-bounty-toggle
              data-more={`${s.showAll} (${bounties.length})`}
              data-less={s.showLess}
            >
              <span data-label>
                {s.showAll} ({bounties.length})
              </span>
              <Icon
                name="arrow"
                class="h-3 w-3 rotate-90 transition-transform group-aria-expanded/more:-rotate-90"
              />
            </button>
          )}
        </div>
      </section>
    )
  }

  <script is:inline>
    (() => {
      const toggle = document.querySelector('[data-bounty-toggle]');
      if (!toggle) return;
      const extras = document.querySelectorAll('[data-bounty-list] [data-extra]');
      const label = toggle.querySelector('[data-label]');
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        extras.forEach((row) => (row.hidden = !open));
        if (label) label.textContent = open ? toggle.dataset.less : toggle.dataset.more;
      });
    })();
  </script>
</BaseLayout>
