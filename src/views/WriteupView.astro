---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import SeverityTag from '../components/SeverityTag.astro';
import RewardTag from '../components/RewardTag.astro';
import Icon from '../components/Icon.astro';
import { getWriteups, readingTimeOf, slugOf, type Writeup } from '../lib/writeups';
import { formatDate, isoDate, slugifyTag } from '../lib/format';
import { profile } from '../config';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  entry: Writeup;
  lang: Locale;
  newer: Writeup | null;
  older: Writeup | null;
  langTargets: Partial<Record<Locale, string>>;
}

const { entry, lang, newer, older, langTargets } = Astro.props;
const s = t(lang);
const {
  title,
  summary,
  pubDate,
  updatedDate,
  tags,
  platform,
  difficulty,
  severity,
  reward,
  author,
  cover,
  coverAlt,
} = entry.data;
const minutes = readingTimeOf(entry);
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const all = await getWriteups(lang);
const position = all.findIndex((item) => item.id === entry.id);
const caseId = `#${String(all.length - Math.max(position, 0)).padStart(3, '0')}`;

const fields = [
  { label: s.fieldDate, value: formatDate(pubDate, lang), datetime: isoDate(pubDate) },
  { label: s.fieldReading, value: `${minutes} min` },
  { label: s.fieldPlatform, value: platform },
  difficulty && { label: s.fieldDifficulty, value: difficulty },
  { label: s.fieldAuthor, value: author ?? profile.name },
  updatedDate && { label: s.updatedOn, value: formatDate(updatedDate, lang) },
].filter(Boolean) as { label: string; value: string; datetime?: string }[];
---

<BaseLayout
  lang={lang}
  title={`${title} — ${profile.name}`}
  description={summary}
  type="article"
  publishedTime={pubDate}
  tags={[...tags]}
  rail={s.railWriteups}
  langTargets={langTargets}
>
  <div class="progress" data-progress aria-hidden="true"></div>

  <a
    href={localeHref(lang, '/writeups')}
    class="group meta hover:text-blood inline-flex items-center gap-2 transition-colors"
  >
    <Icon
      name="arrow"
      class="h-3 w-3 rotate-180 transition-transform group-hover:-translate-x-0.5"
    />
    {s.backToWriteups}
  </a>

  <article class="mt-10">
    <header class="max-w-[860px]">
      <p class="meta eyebrow text-blood">
        {s.caseLabel}
        {caseId}
        <span class="text-hush">/ {platform}</span>
      </p>

      <h1
        class="text-ink mt-6 text-[32px] leading-[1.1] font-semibold tracking-[-0.035em] text-balance sm:text-[46px]"
      >
        {title}
      </h1>

      <p class="text-dim mt-6 max-w-[62ch] text-[17px] leading-relaxed text-pretty">{summary}</p>
    </header>

    {
      cover && (
        <figure class="corners border-rule bg-raise mt-10 border p-1.5">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            widths={[480, 768, 1024, 1440]}
            sizes="(min-width: 1024px) 960px, 100vw"
            class="block h-auto w-full"
          />
        </figure>
      )
    }

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_236px] lg:gap-14">
      <aside class="lg:order-last">
        <div class="space-y-6 lg:sticky lg:top-10">
          <section class="panel corners">
            <h2
              class="meta border-rule flex items-center justify-between border-b px-4 py-2.5 text-[10px]"
            >
              <span>{s.caseFile}</span>
              <span class="jp text-hush tracking-[0.2em]">報告</span>
            </h2>

            <dl class="grid grid-cols-2 gap-x-4 gap-y-3.5 px-4 py-4 lg:grid-cols-1">
              {
                fields.map((field) => (
                  <div>
                    <dt class="meta text-[10px]">{field.label}</dt>
                    <dd class="text-ink mt-0.5 text-[13.5px]">
                      {field.datetime ? (
                        <time datetime={field.datetime}>{field.value}</time>
                      ) : (
                        field.value
                      )}
                    </dd>
                  </div>
                ))
              }
              {
                (severity || reward) && (
                  <div class="col-span-2 lg:col-span-1">
                    <dt class="meta text-[10px]">
                      {[severity && s.fieldSeverity, reward && s.fieldReward]
                        .filter(Boolean)
                        .join(' / ')}
                    </dt>
                    <dd class="mt-1.5 flex flex-wrap gap-1.5">
                      {severity && <SeverityTag severity={severity} />}
                      {reward && <RewardTag reward={reward} />}
                    </dd>
                  </div>
                )
              }
              {
                tags.length > 0 && (
                  <div class="col-span-2 lg:col-span-1">
                    <dt class="meta text-[10px]">{s.fieldTags}</dt>
                    <dd>
                      <ul class="mt-1.5 flex flex-wrap gap-1.5">
                        {tags.map((tag) => (
                          <li>
                            <Tag
                              name={tag}
                              href={`${localeHref(lang, '/writeups')}?tag=${slugifyTag(tag)}`}
                            />
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )
              }
            </dl>
          </section>

          {
            toc.length > 0 && (
              <nav class="hidden lg:block" aria-label={s.toc}>
                <p class="meta text-[10px]">{s.toc}</p>
                <ul class="border-rule mt-3 space-y-2 border-l">
                  {toc.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        data-toc={heading.slug}
                        class:list={[
                          'text-hush hover:text-ink data-[active=true]:text-ink data-[active=true]:border-blood -ml-px block border-l border-transparent text-[13px] leading-snug transition-colors',
                          heading.depth === 3 ? 'pl-6' : 'pl-3.5',
                        ]}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }

          <a
            href="#conteudo"
            class="group meta hover:text-blood hidden items-center gap-2 transition-colors lg:inline-flex"
          >
            <Icon
              name="arrow"
              class="h-3 w-3 -rotate-90 transition-transform group-hover:-translate-y-0.5"
            />
            {s.backToTop}
          </a>
        </div>
      </aside>

      <div class="prose min-w-0" data-prose>
        <Content />
      </div>
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="mt-20 grid gap-4 sm:grid-cols-2" aria-label={s.otherWriteups}>
        {older ? (
          <a
            href={localeHref(lang, `/writeups/${slugOf(older)}`)}
            class="group panel corners corners-hover hover:border-hush/40 flex flex-col p-5 transition-colors"
          >
            <span class="meta inline-flex items-center gap-2">
              <Icon
                name="arrow"
                class="h-3 w-3 rotate-180 transition-transform group-hover:-translate-x-0.5"
              />
              {s.previous}
            </span>
            <span class="text-ink group-hover:text-blood mt-3 block text-[16px] leading-snug font-medium transition-colors">
              {older.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}

        {newer && (
          <a
            href={localeHref(lang, `/writeups/${slugOf(newer)}`)}
            class="group panel corners corners-hover hover:border-hush/40 flex flex-col p-5 transition-colors sm:items-end sm:text-right"
          >
            <span class="meta inline-flex items-center gap-2">
              {s.next}
              <Icon name="arrow" class="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
            </span>
            <span class="text-ink group-hover:text-blood mt-3 block text-[16px] leading-snug font-medium transition-colors">
              {newer.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }

  <script is:inline>
    (() => {
      const bar = document.querySelector('[data-progress]');
      const prose = document.querySelector('[data-prose]');
      if (bar && prose) {
        let ticking = false;
        const update = () => {
          const rect = prose.getBoundingClientRect();
          const total = rect.height - window.innerHeight * 0.6;
          const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
          bar.style.setProperty('--progress', progress.toFixed(4));
          ticking = false;
        };
        const request = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        addEventListener('scroll', request, { passive: true });
        addEventListener('resize', request);
        update();
      }

      const links = Array.from(document.querySelectorAll('[data-toc]'));
      if (links.length && 'IntersectionObserver' in window) {
        const targets = links
          .map((link) => document.getElementById(link.dataset.toc))
          .filter(Boolean);
        const observer = new IntersectionObserver(
          (entries) => {
            for (const item of entries) {
              if (!item.isIntersecting) continue;
              for (const link of links) {
                link.dataset.active = String(link.dataset.toc === item.target.id);
              }
            }
          },
          { rootMargin: '0px 0px -70% 0px' },
        );
        targets.forEach((target) => observer.observe(target));
      }
    })();
  </script>
</BaseLayout>
