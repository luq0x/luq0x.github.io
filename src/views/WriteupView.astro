---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import SeverityTag from '../components/SeverityTag.astro';
import RewardTag from '../components/RewardTag.astro';
import Icon from '../components/Icon.astro';
import { readingTimeOf, slugOf, type Writeup } from '../lib/writeups';
import { formatDate, isoDate, slugifyTag } from '../lib/format';
import { profile } from '../config';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  entry: Writeup;
  lang: Locale;
  newer: Writeup | null;
  older: Writeup | null;
  langTargets: Partial<Record<Locale, string>>;
}

const { entry, lang, newer, older, langTargets } = Astro.props;
const s = t(lang);
const {
  title,
  summary,
  pubDate,
  updatedDate,
  tags,
  platform,
  difficulty,
  severity,
  reward,
  author,
  cover,
  coverAlt,
} = entry.data;
const minutes = readingTimeOf(entry);
const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={`${title} — ${profile.name}`}
  description={summary}
  type="article"
  publishedTime={pubDate}
  tags={[...tags]}
  rail={s.railWriteups}
  langTargets={langTargets}
>
  <a
    href={localeHref(lang, '/writeups')}
    class="group meta hover:text-blood inline-flex items-center gap-2 transition-colors"
  >
    <Icon
      name="arrow"
      class="h-3 w-3 rotate-180 transition-transform group-hover:-translate-x-0.5"
    />
    {s.backToWriteups}
  </a>

  <article class="mt-8">
    <header class="border-rule border-b pb-7">
      {
        (tags.length > 0 || severity || reward) && (
          <ul class="flex flex-wrap gap-1.5">
            {severity && (
              <li>
                <SeverityTag severity={severity} />
              </li>
            )}
            {reward && (
              <li>
                <RewardTag reward={reward} />
              </li>
            )}
            {tags.map((tag) => (
              <li>
                <Tag name={tag} href={`${localeHref(lang, '/writeups')}?tag=${slugifyTag(tag)}`} />
              </li>
            ))}
          </ul>
        )
      }

      <h1
        class="text-ink mt-5 text-[28px] leading-[1.2] font-medium tracking-[-0.03em] text-balance sm:text-[34px]"
      >
        {title}
      </h1>

      <p class="text-dim mt-4 text-[16px] leading-relaxed text-pretty">{summary}</p>

      <div class="meta mt-5 flex flex-wrap items-center gap-x-2 gap-y-1">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate, lang)}</time>
        <span class="slash" aria-hidden="true">/</span>
        <span>{minutes} {s.readingTime}</span>
        <span class="slash" aria-hidden="true">/</span>
        <span class="text-dim">{platform}</span>
        {
          difficulty && (
            <>
              <span class="slash" aria-hidden="true">
                /
              </span>
              <span>{difficulty}</span>
            </>
          )
        }
        <span class="slash" aria-hidden="true">/</span>
        <span>{author ?? profile.name}</span>
      </div>

      {
        updatedDate && (
          <p class="meta mt-1.5">
            {s.updatedOn} {formatDate(updatedDate, lang)}
          </p>
        )
      }
    </header>

    {
      cover && (
        <figure class="border-rule bg-raise mt-10 border p-1">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 768px, 100vw"
            class="block h-auto w-full"
          />
        </figure>
      )
    }

    <div class="prose mt-10">
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav
        class="border-rule mt-16 grid gap-3 border-t pt-8 sm:grid-cols-2"
        aria-label={s.otherWriteups}
      >
        {older ? (
          <a
            href={localeHref(lang, `/writeups/${slugOf(older)}`)}
            class="group border-rule hover:border-blood hover:bg-raise/60 border p-4 transition-colors"
          >
            <span class="meta">{s.previous}</span>
            <span class="text-ink group-hover:text-blood mt-1.5 block text-[14.5px] leading-snug transition-colors">
              {older.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}

        {newer && (
          <a
            href={localeHref(lang, `/writeups/${slugOf(newer)}`)}
            class="group border-rule hover:border-blood hover:bg-raise/60 border p-4 transition-colors sm:text-right"
          >
            <span class="meta">{s.next}</span>
            <span class="text-ink group-hover:text-blood mt-1.5 block text-[14.5px] leading-snug transition-colors">
              {newer.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
