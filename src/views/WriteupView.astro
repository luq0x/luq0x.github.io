---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import SeverityTag from '../components/SeverityTag.astro';
import RewardTag from '../components/RewardTag.astro';
import { readingTimeOf, slugOf, type Writeup } from '../lib/writeups';
import { formatDate, isoDate, slugifyTag } from '../lib/format';
import { profile } from '../config';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  entry: Writeup;
  lang: Locale;
  newer: Writeup | null;
  older: Writeup | null;
  langTargets: Partial<Record<Locale, string>>;
}

const { entry, lang, newer, older, langTargets } = Astro.props;
const s = t(lang);
const {
  title,
  summary,
  pubDate,
  updatedDate,
  tags,
  platform,
  difficulty,
  severity,
  reward,
  author,
  cover,
  coverAlt,
} = entry.data;
const minutes = readingTimeOf(entry);
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const fields = [
  { label: s.fieldDate, value: formatDate(pubDate, lang), datetime: isoDate(pubDate) },
  { label: s.fieldReading, value: `${minutes} min` },
  { label: s.fieldPlatform, value: platform },
  difficulty && { label: s.fieldDifficulty, value: difficulty },
  { label: s.fieldAuthor, value: author ?? profile.name },
  updatedDate && { label: s.updatedOn, value: formatDate(updatedDate, lang) },
].filter(Boolean) as { label: string; value: string; datetime?: string }[];
---

<BaseLayout
  lang={lang}
  title={`${title} — ${profile.name}`}
  description={summary}
  type="article"
  publishedTime={pubDate}
  tags={[...tags]}
  langTargets={langTargets}
  edges={false}
>
  <div class="progress" data-progress aria-hidden="true"></div>

  <a href={localeHref(lang, '/writeups')} class="more">
    <span class="prompt">$</span> cd ..
  </a>

  <article class="relative mt-8">
    {
      toc.length > 0 && (
        <aside class="absolute top-0 right-full bottom-0 mr-10 hidden w-52 min-[1400px]:block">
          <nav class="sticky top-8" aria-label={s.toc}>
            <p class="meta mb-3 uppercase">{s.toc}</p>
            <ul class="border-rule space-y-1.5 border-l">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-toc={heading.slug}
                    class:list={[
                      'text-hush hover:text-ink data-[active=true]:text-accent data-[active=true]:border-accent -ml-px block border-l border-transparent text-xs leading-snug transition-colors',
                      heading.depth === 3 ? 'pl-6' : 'pl-3',
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
    <header>
      <h1 class="text-ink text-[1.625rem] leading-[1.25] font-bold text-balance sm:text-[1.875rem]">
        {title}
      </h1>

      <p class="text-dim mt-4 text-pretty">{summary}</p>

      <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-1">
        {
          severity && (
            <li>
              <SeverityTag severity={severity} />
            </li>
          )
        }
        {
          reward && (
            <li>
              <RewardTag reward={reward} />
            </li>
          )
        }
        {
          tags.map((tag) => (
            <li>
              <Tag name={tag} href={`${localeHref(lang, '/writeups')}?tag=${slugifyTag(tag)}`} />
            </li>
          ))
        }
      </ul>

      <dl class="meta mt-4 flex flex-wrap gap-x-5 gap-y-1">
        {
          fields.map((field) => (
            <div class="flex gap-1.5">
              <dt>{field.label.toLowerCase()}:</dt>
              <dd class="text-dim">
                {field.datetime ? (
                  <time datetime={field.datetime}>{field.value}</time>
                ) : (
                  field.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </header>

    {
      cover && (
        <figure class="mt-8">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            widths={[480, 768, 1024, 1440]}
            sizes="(min-width: 832px) 832px, 100vw"
            class="border-rule block h-auto w-full border"
          />
        </figure>
      )
    }

    {
      toc.length > 0 && (
        <details class="border-rule mt-8 border border-dashed px-4 py-3 min-[1400px]:hidden">
          <summary class="meta hover:text-accent cursor-pointer select-none">
            {s.toc.toLowerCase()}
          </summary>
          <ul class="mt-3 space-y-1.5">
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-5']}>
                <a
                  href={`#${heading.slug}`}
                  data-toc={heading.slug}
                  class="text-dim hover:text-accent data-[active=true]:text-accent text-[0.8125rem] transition-colors"
                >
                  {heading.depth === 3 ? '└ ' : ''}
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="prose mt-10 min-w-0" data-prose>
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav
        class="border-rule mt-16 grid gap-6 border-t border-dashed pt-6 sm:grid-cols-2"
        aria-label={s.otherWriteups}
      >
        {older ? (
          <a href={localeHref(lang, `/writeups/${slugOf(older)}`)} class="group block">
            <span class="meta">← {s.previous.toLowerCase()}</span>
            <span class="text-ink group-hover:text-accent mt-1 block transition-colors">
              {older.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}

        {newer && (
          <a
            href={localeHref(lang, `/writeups/${slugOf(newer)}`)}
            class="group block sm:text-right"
          >
            <span class="meta">{s.next.toLowerCase()} →</span>
            <span class="text-ink group-hover:text-accent mt-1 block transition-colors">
              {newer.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }

  <script is:inline>
    (() => {
      const bar = document.querySelector('[data-progress]');
      const prose = document.querySelector('[data-prose]');
      if (bar && prose) {
        let ticking = false;
        const update = () => {
          const rect = prose.getBoundingClientRect();
          const total = rect.height - window.innerHeight * 0.6;
          const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
          bar.style.setProperty('--progress', progress.toFixed(4));
          ticking = false;
        };
        const request = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        addEventListener('scroll', request, { passive: true });
        addEventListener('resize', request);
        update();
      }

      const links = Array.from(document.querySelectorAll('[data-toc]'));
      if (links.length && 'IntersectionObserver' in window) {
        const targets = links
          .map((link) => document.getElementById(link.dataset.toc))
          .filter(Boolean);
        const observer = new IntersectionObserver(
          (entries) => {
            for (const item of entries) {
              if (!item.isIntersecting) continue;
              for (const link of links) {
                link.dataset.active = String(link.dataset.toc === item.target.id);
              }
            }
          },
          { rootMargin: '0px 0px -70% 0px' },
        );
        targets.forEach((target) => observer.observe(target));
      }
    })();
  </script>
</BaseLayout>
