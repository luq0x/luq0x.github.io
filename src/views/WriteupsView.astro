---
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { getWriteups, collectTags } from '../lib/writeups';
import { slugifyTag } from '../lib/format';
import { localeHref, locales, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = t(lang);

const entries = await getWriteups(lang);
const tags = collectTags(entries);
const PAGE_SIZE = 10;

const langTargets = Object.fromEntries(
  locales.map((locale) => [locale, localeHref(locale, '/writeups')]),
) as Record<Locale, string>;

let lastYear: number | null = null;
const rows = entries.map((entry, index) => {
  const year = entry.data.pubDate.getUTCFullYear();
  const startsYear = year !== lastYear;
  lastYear = year;
  return { entry, year, startsYear, number: entries.length - index };
});

const chip =
  'border border-rule bg-void/60 px-2.5 py-1.5 font-mono text-[10.5px] tracking-[0.06em] text-dim uppercase transition-colors hover:border-hush hover:text-ink aria-pressed:border-blood aria-pressed:bg-blood/10 aria-pressed:text-blood';
---

<BaseLayout
  lang={lang}
  title={`${s.writeupsTitle} — ${s.siteTitle}`}
  description={s.writeupsDescription}
  rail={s.railWriteups}
  langTargets={langTargets}
>
  <header class="relative pt-2 pb-10">
    <span
      class="jp outline-text pointer-events-none absolute -top-4 right-0 hidden text-[120px] leading-none select-none md:block"
      aria-hidden="true"
    >
      {s.railWriteups}
    </span>
    <p class="meta eyebrow text-blood">{s.railWriteups} / archive</p>
    <h1 class="display text-ink mt-5 text-[56px] sm:text-[80px]">{s.writeupsTitle}</h1>
    <p class="text-dim mt-5 max-w-[52ch] text-[16px]">
      <span class="text-ink font-mono">{String(entries.length).padStart(2, '0')}</span>{' '}
      {entries.length === 1 ? s.postSingular : s.postPlural} · {s.writeupsIntro}
    </p>
  </header>

  {
    entries.length > 0 && (
      <div class="topbar border-rule sticky top-14 z-20 -mx-5 border-y px-5 py-3 sm:-mx-8 sm:px-8 lg:top-0 lg:-mx-12 lg:px-12">
        <label class="group border-rule focus-within:border-blood bg-void/70 flex items-center gap-3 border px-3 transition-colors">
          <span class="sr-only">{s.searchLabel}</span>
          <svg
            viewBox="0 0 24 24"
            class="text-hush group-focus-within:text-blood h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6.5" />
            <path d="m16 16 4.5 4.5" />
          </svg>
          <input
            type="search"
            data-search-input
            placeholder={s.searchPlaceholder}
            autocomplete="off"
            spellcheck="false"
            class="text-ink placeholder:text-hush h-10 min-w-0 flex-1 bg-transparent font-mono text-[13px] outline-none"
          />
          <kbd class="border-rule text-hush hidden border px-1.5 font-mono text-[10px] sm:block">
            /
          </kbd>
        </label>

        {tags.length > 0 && (
          <div class="mt-3">
            <h2 class="sr-only">{s.filterHeading}</h2>
            <ul class="flex flex-wrap gap-1.5">
              <li>
                <button type="button" data-tag-filter="all" aria-pressed="true" class={chip}>
                  {s.filterAll} <span class="text-hush">{entries.length}</span>
                </button>
              </li>
              {tags.map((tag) => (
                <li>
                  <button
                    type="button"
                    data-tag-filter={slugifyTag(tag.name)}
                    aria-pressed="false"
                    class={chip}
                  >
                    {tag.name} <span class="text-hush">{tag.count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )
  }

  <div class="mt-4 [&>[data-writeup]]:mb-4" data-list>
    {
      rows.map(({ entry, year, startsYear, number }) => (
        <>
          {startsYear && (
            <h2 class="flex items-center gap-4 pt-10 pb-5" data-year={year}>
              <span class="text-ink font-mono text-[13px] tracking-[0.1em]">{year}</span>
              <span class="bg-rule h-px flex-1" aria-hidden="true" />
            </h2>
          )}
          <WriteupCard entry={entry} lang={lang} number={number} />
        </>
      ))
    }
  </div>

  <div class="panel mt-10 hidden px-6 py-10 text-center" data-empty>
    <p class="jp text-hush text-[18px]" aria-hidden="true">探索</p>
    <p class="text-dim mt-3 text-[14.5px]">{s.emptyTag}</p>
  </div>

  <div class="mt-8 hidden" data-more-wrapper>
    <button
      type="button"
      data-more
      class="border-rule text-dim hover:border-blood hover:text-blood bg-void/60 w-full border py-3 font-mono text-[12px] tracking-[0.1em] uppercase transition-colors"
    >
      {s.loadMore}
    </button>
  </div>

  {entries.length === 0 && <p class="text-dim mt-10 text-[14.5px]">{s.emptyList}</p>}

  <script is:inline define:vars={{ PAGE_SIZE }}>
    (() => {
      const list = document.querySelector('[data-list]');
      if (!list) return;

      const cards = Array.from(list.querySelectorAll('[data-writeup]'));
      const years = Array.from(list.querySelectorAll('[data-year]'));
      const buttons = Array.from(document.querySelectorAll('[data-tag-filter]'));
      const moreWrapper = document.querySelector('[data-more-wrapper]');
      const moreButton = document.querySelector('[data-more]');
      const empty = document.querySelector('[data-empty]');
      const search = document.querySelector('[data-search-input]');

      let activeTag = new URLSearchParams(location.search).get('tag') || 'all';
      if (activeTag !== 'all' && !buttons.some((b) => b.dataset.tagFilter === activeTag)) {
        activeTag = 'all';
      }
      let visible = PAGE_SIZE;
      let query = '';

      const matches = (card) =>
        (activeTag === 'all' || (card.dataset.tags || '').split(' ').includes(activeTag)) &&
        (!query || query.split(/\s+/).every((word) => (card.dataset.search || '').includes(word)));

      function render() {
        let shown = 0;
        let total = 0;

        for (const card of cards) {
          if (!matches(card)) {
            card.hidden = true;
            continue;
          }
          total += 1;
          const show = shown < visible;
          card.hidden = !show;
          if (show) shown += 1;
        }

        for (const year of years) {
          let node = year.nextElementSibling;
          let has = false;
          while (node && !node.hasAttribute('data-year')) {
            if (node.hasAttribute('data-writeup') && !node.hidden) {
              has = true;
              break;
            }
            node = node.nextElementSibling;
          }
          year.hidden = !has;
        }

        for (const button of buttons) {
          button.setAttribute('aria-pressed', String(button.dataset.tagFilter === activeTag));
        }

        if (empty) empty.classList.toggle('hidden', total > 0);
        if (moreWrapper) moreWrapper.classList.toggle('hidden', shown >= total);
      }

      for (const button of buttons) {
        button.addEventListener('click', () => {
          activeTag = button.dataset.tagFilter;
          visible = PAGE_SIZE;

          const params = new URLSearchParams(location.search);
          if (activeTag === 'all') params.delete('tag');
          else params.set('tag', activeTag);
          const query = params.toString();
          history.replaceState(null, '', query ? `?${query}` : location.pathname);

          render();
        });
      }

      search?.addEventListener('input', () => {
        query = search.value.trim().toLowerCase();
        visible = PAGE_SIZE;
        render();
      });

      document.addEventListener('keydown', (event) => {
        const target = event.target;
        const typing =
          target instanceof HTMLElement &&
          (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));
        if (event.key === '/' && !typing && search) {
          event.preventDefault();
          search.focus();
        }
        if (event.key === 'Escape' && target === search && search.value) {
          search.value = '';
          query = '';
          render();
        }
      });

      moreButton?.addEventListener('click', () => {
        visible += PAGE_SIZE;
        render();
      });

      render();
    })();
  </script>
</BaseLayout>
