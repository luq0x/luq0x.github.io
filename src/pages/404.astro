---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeHref, strings } from '../i18n';

const blocks = [
  { lang: 'pt-br', s: strings['pt-br'] },
  { lang: 'en', s: strings.en },
] as const;

const art = [
  ' _  _    ___  _  _  ',
  '| || |  / _ \\| || | ',
  '| || |_| | | | || |_',
  '|__   _| |_| |__   _|',
  '   |_|  \\___/   |_|  ',
].join('\n');
---

<BaseLayout lang="pt-br" title="404" description={strings['pt-br'].notFoundBody}>
  <pre class="ascii text-[0.8125rem] sm:text-base" aria-hidden="true">{art}</pre>

  <p class="mt-6"><span class="prompt">$</span> cd {'$OLDPWD'}</p>
  <p class="text-crit pl-4">bash: 404: No such file or directory</p>

  <div class="mt-10 space-y-8">
    {
      blocks.map(({ lang, s }, index) => (
        <section lang={s.htmlLang}>
          {index === 0 ? (
            <h1 class="text-ink font-bold">{s.notFoundTitle}</h1>
          ) : (
            <h2 class="text-ink font-bold">{s.notFoundTitle}</h2>
          )}
          <p class="text-dim mt-1">{s.notFoundBody}</p>
          <p class="mt-3 flex gap-5">
            <a href={localeHref(lang)} class="link">
              {s.backHome.toLowerCase()}
            </a>
            <a href={localeHref(lang, '/writeups')} class="link">
              {s.writeupsTitle.toLowerCase()}
            </a>
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>
