---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  langTargets?: Partial<Record<Locale, string>>;
  edges?: boolean;
}

const {
  lang,
  title,
  description,
  type,
  publishedTime,
  tags,
  langTargets,
  edges = true,
} = Astro.props;

const s = t(lang);
const edge = (() => {
  let seed = 0xbeef;
  return Array.from({ length: 3 * 400 }, () => {
    seed = (seed * 1664525 + 1013904223) >>> 0;
    return (seed >>> 16) & 1;
  }).join('');
})();
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <BaseHead
      lang={lang}
      title={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
      langTargets={langTargets}
    />
  </head>
  <body class="relative min-h-dvh overflow-x-hidden">
    {
      edges && (
        <>
          <div class="edge edge-l hidden min-[960px]:block" aria-hidden="true">
            {edge}
          </div>
          <div class="edge edge-r hidden min-[960px]:block" aria-hidden="true">
            {edge}
          </div>
        </>
      )
    }
    <a
      href="#conteudo"
      class="focus:bg-raise sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-3 focus:py-2"
    >
      {s.skipToContent}
    </a>

    <div class="frame flex flex-col">
      <Header lang={lang} langTargets={langTargets} />

      <main id="conteudo" class="wrap flex-1 pt-8">
        <slot />
      </main>

      <Footer lang={lang} />
    </div>
  </body>
</html>
