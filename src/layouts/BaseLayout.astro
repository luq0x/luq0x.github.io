---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  rail?: string;
  width?: 'read' | 'wide';
  langTargets?: Partial<Record<Locale, string>>;
}

const {
  lang,
  title,
  description,
  type,
  publishedTime,
  tags,
  rail,
  width = 'wide',
  langTargets,
} = Astro.props;

const s = t(lang);
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <BaseHead
      lang={lang}
      title={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
      langTargets={langTargets}
    />
  </head>
  <body class="min-h-dvh">
    <div class="wallpaper-glow" aria-hidden="true"></div>
    <div class="wallpaper" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>

    <a
      href="#conteudo"
      class="focus:bg-raise sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-3 focus:py-2 focus:text-sm"
    >
      {s.skipToContent}
    </a>

    <Sidebar lang={lang} rail={rail} langTargets={langTargets} />

    <div class="shell-main flex min-h-dvh flex-col">
      <main id="conteudo" class="flex-1">
        <div
          class:list={[
            'mx-auto w-full px-5 pt-10 pb-16 sm:px-8 lg:px-12 lg:pt-16',
            width === 'read' ? 'max-w-[760px]' : 'max-w-[1080px]',
          ]}
        >
          <slot />
        </div>
      </main>

      <Footer lang={lang} />
    </div>
  </body>
</html>
