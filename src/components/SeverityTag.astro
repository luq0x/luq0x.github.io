---
import type { Severity } from '../config';

interface Props {
  severity: Severity;
}

const { severity } = Astro.props;

const tone: Record<Severity, string> = {
  Critical: 'tag-crit',
  High: 'tag-high',
  Medium: '',
  Low: '',
};
---

<span class:list={['tag', tone[severity]]}>{severity.toLowerCase()}</span>
