---
// 14 rows: ascender 0-3, x-height 4-10, descender 11-13. Each pixel is two characters wide.
const glyphs: Record<string, string[]> = {
  l: [
    '1110',
    '0110',
    '0110',
    '0110',
    '0110',
    '0110',
    '0110',
    '0110',
    '0110',
    '0110',
    '0111',
    '0000',
    '0000',
    '0000',
  ],
  u: [
    '000000',
    '000000',
    '000000',
    '000000',
    '110011',
    '110011',
    '110011',
    '110011',
    '110011',
    '110111',
    '011111',
    '000000',
    '000000',
    '000000',
  ],
  q: [
    '000000',
    '000000',
    '000000',
    '000000',
    '011111',
    '110011',
    '110011',
    '110011',
    '110011',
    '110111',
    '011111',
    '000011',
    '000011',
    '000011',
  ],
};

const word = 'luq';
const padX = 5;
const padY = 1;
const gap = 2;

const letters = [...word].map((ch) => glyphs[ch]);
const widths = letters.map((g) => g[0].length);
const textWidth = widths.reduce((a, b) => a + b, 0) + gap * (letters.length - 1);
const cols = textWidth + padX * 2;
const rows = letters[0].length + padY * 2;

const on = new Set<string>();
let x0 = padX;
letters.forEach((glyph, index) => {
  glyph.forEach((line, y) => {
    [...line].forEach((cell, x) => {
      if (cell === '1') on.add(`${x0 + x},${padY + y}`);
    });
  });
  x0 += widths[index] + gap;
});

let seed = 0x1ee7;
const bit = () => {
  seed = (seed * 1664525 + 1013904223) >>> 0;
  return (seed >>> 16) & 1;
};

const lines = Array.from({ length: rows }, (_, y) =>
  Array.from({ length: cols }, (_, x) => {
    if (on.has(`${x},${y}`)) return '<b>11</b>';
    if (on.has(`${x - 1},${y - 1}`)) return '<i>00</i>';
    return `${bit()}${bit()}`;
  }).join(''),
);

const art = lines.join('\n');
---

<div role="img" aria-label="luq">
  <pre class="binary-art" aria-hidden="true" set:html={art} />
</div>
