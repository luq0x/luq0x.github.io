---
import { bounties, type Severity } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = t(lang);

const tone: Record<Severity, string> = {
  Critical: 'bg-blood',
  High: 'bg-blood/60',
  Medium: 'bg-hush',
  Low: 'bg-rule',
};

const total = bounties.length;
---

{
  total > 0 && (
    <section class="border-rule mt-12 border-t pt-8" aria-labelledby="bounties">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="bounties" class="meta">
          {s.latestBounties}
        </h2>
        <span class="meta">{String(total).padStart(2, '0')}</span>
      </div>

      <div class="ticker -mx-6 mt-4 px-6">
        <div class="ticker-inner">
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
              {bounties.map((bounty) => (
                <li class="flex shrink-0 items-center gap-3 pr-8">
                  <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${tone[bounty.severity]}`} />
                  <span class="text-ink font-mono text-[12px] whitespace-nowrap">
                    {bounty.program}
                  </span>
                  <span class="text-dim font-mono text-[12px] whitespace-nowrap">
                    {bounty.type}
                  </span>
                  <span class="text-blood font-mono text-[12px] whitespace-nowrap tabular-nums">
                    {bounty.reward}
                  </span>
                  <span class="meta whitespace-nowrap">{bounty.date}</span>
                  <span class="slash pl-5" aria-hidden="true">
                    /
                  </span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}
