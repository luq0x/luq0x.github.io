---
import { bounties, type Severity } from '../config';

const tone: Record<Severity, string> = {
  Critical: 'text-crit',
  High: 'text-high',
  Medium: 'text-dim',
  Low: 'text-hush',
};

const duration = `${Math.max(bounties.length * 4, 30)}s`;
---

{
  bounties.length > 0 && (
    <div class="ticker" style={`--ticker-duration: ${duration}`}>
      <div class="ticker-inner">
        {[0, 1].map((copy) => (
          <ul
            class="flex shrink-0 items-stretch gap-2.5 pr-2.5"
            aria-hidden={copy === 1 ? 'true' : undefined}
          >
            {bounties.map((bounty) => {
              const program = bounty.href ? (
                <a
                  href={bounty.href}
                  target="_blank"
                  rel="noopener"
                  tabindex={copy === 1 ? -1 : undefined}
                  class="link"
                >
                  {bounty.program}
                </a>
              ) : (
                bounty.program
              );
              return (
                <li class="bounty">
                  <div class="flex items-center justify-between gap-6">
                    <span class="meta whitespace-nowrap">{bounty.date}</span>
                    <span class="text-accent font-semibold whitespace-nowrap tabular-nums">
                      {bounty.reward}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 whitespace-nowrap">
                    <span
                      class={`text-xs ${bounty.severity ? tone[bounty.severity] : 'text-hush'}`}
                    >
                      ▪
                    </span>
                    <span class="text-ink">{bounty.type}</span>
                    <span class="sep" aria-hidden="true">
                      @
                    </span>
                    <span class="text-dim">{program}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </div>
  )
}
