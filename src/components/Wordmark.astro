---
interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}

const { size = 'sm', class: className = '' } = Astro.props;
const scale = size === 'lg' ? 'text-[44px] sm:text-[52px]' : 'text-[15px]';
---

<span class:list={['text-ink font-medium tracking-[-0.03em]', scale, className]}>
  luq0x
</span>