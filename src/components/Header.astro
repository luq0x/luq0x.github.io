---
import LangSwitch from './LangSwitch.astro';
import { profile } from '../config';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  langTargets?: Partial<Record<Locale, string>>;
}

const { lang, langTargets } = Astro.props;
const s = t(lang);

const nav = [
  { label: s.navHome, href: localeHref(lang), exact: true },
  { label: s.navWriteups, href: localeHref(lang, '/writeups'), exact: false },
  { label: s.navAbout, href: localeHref(lang, '/about'), exact: false },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, exact: boolean) => {
  const target = href.replace(/\/$/, '') || '/';
  if (exact) return current === target;
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-6 pb-5">
  <a
    href={localeHref(lang)}
    class="flex items-center font-bold text-white"
    aria-label={profile.name}
  >
    <span class="prompt mr-2">&gt;</span>{profile.name}<span
      class="bg-accent animate-blink ml-1 inline-block h-[1em] w-[0.55em] translate-y-[0.12em]"
      aria-hidden="true"></span>
  </a>

  <div class="flex items-center gap-6">
    <nav aria-label={s.navPrimary}>
      <ul class="flex items-center gap-5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
              >
                {item.label.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangSwitch lang={lang} targets={langTargets} />
  </div>
</header>
