---
import BinaryRule from './BinaryRule.astro';
import SocialLinks from './SocialLinks.astro';
import { profile } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="wrap mt-20 pb-8">
  <BinaryRule />
  <div class="mt-5 flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
    <SocialLinks lang={lang} />
    <p class="meta flex items-center gap-3">
      <span>© {year} {profile.name}</span>
      <a href="#conteudo" class="more">{s.backToTop.toLowerCase()} ↑</a>
    </p>
  </div>
</footer>
