---
import { locales, localeHref, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  targets?: Partial<Record<Locale, string>>;
  class?: string;
}

const { lang, targets, class: className = '' } = Astro.props;

const labels: Record<Locale, string> = { 'pt-br': 'PT', en: 'EN' };
---

<nav class:list={['flex items-center gap-2', className]} aria-label="Language">
  {
    locales.map((locale, index) => (
      <>
        {index > 0 && (
          <span class="text-hush" aria-hidden="true">
            /
          </span>
        )}
        <a
          href={targets?.[locale] ?? localeHref(locale)}
          hreflang={locale === 'en' ? 'en-US' : 'pt-BR'}
          aria-current={locale === lang ? 'true' : undefined}
          class:list={['meta hover:text-ink transition-colors', locale === lang && 'text-blood']}
        >
          {labels[locale]}
        </a>
      </>
    ))
  }
</nav>
