---
import BinaryArt from './BinaryArt.astro';
---

<div class="hero-binary" data-binary-hero role="img" aria-label="LUQ">
  <canvas aria-hidden="true"></canvas>
  <noscript><BinaryArt /></noscript>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-binary-hero]');
    const canvas = root?.querySelector('canvas');
    if (!root || !canvas) return;
    const ctx = canvas.getContext('2d');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const WORD = 'LUQ';
    const FONT = '"JetBrains Mono Variable", ui-monospace, monospace';

    let W = 0;
    let H = 0;
    let cellW = 0;
    let cellH = 0;
    let cols = 0;
    let rows = 0;
    let on = [];
    let digits = [];
    let fluid = null;
    let raf = 0;
    let last = 0;
    const mouse = { x: -9999, y: -9999 };

    // Tiny fluid: an energy + velocity field that the pointer stirs, advects and diffuses.
    function createFluid(cols, rows) {
      const n = cols * rows;
      let en = new Float32Array(n);
      let vx = new Float32Array(n);
      let vy = new Float32Array(n);
      let en2 = new Float32Array(n);
      let vx2 = new Float32Array(n);
      let vy2 = new Float32Array(n);
      const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);

      function inject(cx, cy, dx, dy, radius) {
        const speed = Math.min(Math.hypot(dx, dy), 4);
        const x0 = Math.max(0, Math.floor(cx - radius));
        const x1 = Math.min(cols - 1, Math.ceil(cx + radius));
        const y0 = Math.max(0, Math.floor(cy - radius));
        const y1 = Math.min(rows - 1, Math.ceil(cy + radius));
        for (let r = y0; r <= y1; r++) {
          for (let c = x0; c <= x1; c++) {
            const d = Math.hypot(c - cx, r - cy);
            if (d >= radius) continue;
            const f = (1 - d / radius) ** 2;
            const i = r * cols + c;
            en[i] = Math.min(1.6, en[i] + f * (0.18 + speed * 0.22));
            vx[i] = clamp(vx[i] + dx * f * 0.7, -3, 3);
            vy[i] = clamp(vy[i] + dy * f * 0.7, -3, 3);
          }
        }
      }

      function step() {
        // advect (semi-Lagrangian) + diffuse + decay
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const i = r * cols + c;
            const sc = clamp(Math.round(c - vx[i] * 0.9), 0, cols - 1);
            const sr = clamp(Math.round(r - vy[i] * 0.9), 0, rows - 1);
            const j = sr * cols + sc;
            const l = c > 0 ? j - 1 : j;
            const rt = c < cols - 1 ? j + 1 : j;
            const u = r > 0 ? j - cols : j;
            const d = r < rows - 1 ? j + cols : j;
            en2[i] = (en[j] * 0.52 + (en[l] + en[rt] + en[u] + en[d]) * 0.12) * 0.965;
            vx2[i] = (vx[j] * 0.52 + (vx[l] + vx[rt] + vx[u] + vx[d]) * 0.12) * 0.965;
            vy2[i] = (vy[j] * 0.52 + (vy[l] + vy[rt] + vy[u] + vy[d]) * 0.12) * 0.965;
          }
        }
        [en, en2] = [en2, en];
        [vx, vx2] = [vx2, vx];
        [vy, vy2] = [vy2, vy];
      }

      return {
        inject,
        step,
        get en() {
          return en;
        },
        get vx() {
          return vx;
        },
        get vy() {
          return vy;
        },
      };
    }

    function build() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = root.clientWidth;
      cols = W > 600 ? 92 : 50;
      cellW = W / cols;
      cellH = cellW * 1.35;
      H = Math.round((W * 0.4) / cellH) * cellH;
      rows = Math.round(H / cellH);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // rasterise the word with a real heavy font, stretched to fill the whole width
      const off = document.createElement('canvas');
      off.width = Math.round(W);
      off.height = Math.round(H);
      const o = off.getContext('2d', { willReadFrequently: true });
      const size = H * 1.02;
      o.font = `800 ${size}px ${FONT}`;
      o.textBaseline = 'alphabetic';
      const m = o.measureText(WORD);
      const ascent = m.actualBoundingBoxAscent;
      const descent = m.actualBoundingBoxDescent;
      const textW = m.actualBoundingBoxRight + m.actualBoundingBoxLeft;
      const fit = (H * 0.94) / (ascent + descent);
      o.font = `800 ${size * fit}px ${FONT}`;
      const m2 = o.measureText(WORD);
      const tw = m2.actualBoundingBoxRight + m2.actualBoundingBoxLeft;
      const sx = Math.min(1.9, (W * 0.98) / tw);
      o.save();
      o.translate(W / 2, (H + (m2.actualBoundingBoxAscent - m2.actualBoundingBoxDescent)) / 2);
      o.scale(sx, 1);
      o.fillStyle = '#fff';
      const tx = -(m2.actualBoundingBoxRight - m2.actualBoundingBoxLeft) / 2;
      o.strokeStyle = '#fff';
      o.lineJoin = 'round';
      o.lineWidth = H * 0.09;
      o.strokeText(WORD, tx, 0);
      o.fillText(WORD, tx, 0);
      o.restore();

      const img = o.getImageData(0, 0, off.width, off.height).data;
      on = new Array(cols * rows);
      digits = new Array(cols * rows);
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const px = Math.min(off.width - 1, Math.floor(c * cellW + cellW / 2));
          const py = Math.min(off.height - 1, Math.floor(r * cellH + cellH / 2));
          on[r * cols + c] = img[(py * off.width + px) * 4 + 3] > 120;
          digits[r * cols + c] = Math.random() < 0.5 ? '0' : '1';
        }
      }
      fluid = createFluid(cols, rows);
      ctx.font = `700 ${cellW * 1.15}px ${FONT}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
    }

    function draw(t) {
      const animate = !still.matches;
      if (animate) fluid.step();
      ctx.clearRect(0, 0, W, H);
      // highlight band sweeping across the name
      const period = 5200;
      const phase = (t % period) / period;
      const band = phase * (cols + 24) - 12;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const i = r * cols + c;
          const x = c * cellW + cellW / 2;
          const y = r * cellH + cellH / 2;
          const near = animate ? Math.min(1, fluid.en[i]) : 0;
          const sweep = animate ? Math.max(0, 1 - Math.abs(c - band - r * 0.35) / 5) : 0;

          if (animate && Math.random() < (on[i] ? 0.01 : 0.004) + near * 0.3 + sweep * 0.25) {
            digits[i] = digits[i] === '0' ? '1' : '0';
          }

          if (on[i]) {
            if (near > 0.25 || sweep > 0.35) {
              ctx.fillStyle = '#fff';
              ctx.shadowColor = '#fff';
              ctx.shadowBlur = 10;
              ctx.globalAlpha = 1;
            } else {
              ctx.fillStyle = '#ff3b30';
              ctx.shadowColor = 'rgba(255,59,48,0.6)';
              ctx.shadowBlur = 9;
              ctx.globalAlpha = 1;
            }
          } else {
            ctx.shadowBlur = 0;
            ctx.fillStyle = near > 0.1 ? '#fff' : '#ff3b30';
            ctx.globalAlpha = 0.055 + near * 0.55 + sweep * 0.2;
          }
          ctx.fillText(digits[i], x + fluid.vx[i] * near * 4, y + fluid.vy[i] * near * 4);
        }
      }
      ctx.shadowBlur = 0;
      ctx.globalAlpha = 1;
    }

    function loop(t) {
      raf = requestAnimationFrame(loop);
      if (t - last < 45) return;
      last = t;
      draw(t);
    }

    function start() {
      cancelAnimationFrame(raf);
      build();
      if (still.matches) draw(0);
      else raf = requestAnimationFrame(loop);
    }

    root.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (fluid && mouse.x > -9000) {
        fluid.inject(x / cellW, y / cellH, (x - mouse.x) / cellW, (y - mouse.y) / cellH, 6);
      }
      mouse.x = x;
      mouse.y = y;
    });
    root.addEventListener('mouseleave', () => {
      mouse.x = mouse.y = -9999;
    });
    let timer = 0;
    addEventListener('resize', () => {
      clearTimeout(timer);
      timer = setTimeout(start, 150);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else start();
    });
    Promise.all([document.fonts?.load(`800 100px ${FONT}`, WORD), document.fonts?.ready]).then(
      start,
      start,
    );
  })();
</script>
