---
import Icon from './Icon.astro';
import { socials } from '../config';
import { localeHref, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  class?: string;
  showRss?: boolean;
}

const { lang, class: className = '', showRss = true } = Astro.props;
const isMail = (href: string) => href.startsWith('mailto:');
---

<ul class:list={['flex flex-wrap items-center gap-x-5 gap-y-2', className]}>
  {
    socials.map((social) => (
      <li>
        <a
          href={social.href}
          rel={isMail(social.href) ? undefined : 'me noopener'}
          target={isMail(social.href) ? undefined : '_blank'}
          class="social"
        >
          <Icon name={social.icon} class="h-3.5 w-3.5 shrink-0" />
          {social.label.toLowerCase()}
        </a>
      </li>
    ))
  }
  {
    showRss && (
      <li>
        <a href={localeHref(lang, '/rss.xml')} class="social">
          <Icon name="rss" class="h-3.5 w-3.5 shrink-0" />
          rss
        </a>
      </li>
    )
  }
</ul>
