---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import SeverityTag from './SeverityTag.astro';
import RewardTag from './RewardTag.astro';
import { formatDate, isoDate, slugifyTag } from '../lib/format';
import { readingTimeOf, slugOf, type Writeup } from '../lib/writeups';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  entry: Writeup;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const s = t(lang);
const { title, summary, pubDate, tags, platform, severity, reward, cover, coverAlt } = entry.data;
const minutes = readingTimeOf(entry);
const href = localeHref(lang, `/writeups/${slugOf(entry)}`);
const search = [title, summary, platform, severity, reward, ...tags].filter(Boolean).join(' ');
---

<article
  class="item"
  data-writeup
  data-tags={tags.map(slugifyTag).join(' ')}
  data-search={search.toLowerCase()}
>
  <div class="item-cover">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[320, 480]}
          sizes="(min-width: 640px) 176px, 100vw"
        />
      ) : (
        <div class="text-hush flex h-full w-full items-center justify-center text-xs">{'>_'}</div>
      )
    }
  </div>

  <div class="flex min-w-0 flex-col">
    <p class="meta flex flex-wrap items-center gap-x-2">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate, lang)}</time>
      <span class="sep" aria-hidden="true">·</span>
      <span>{minutes} {s.readingTime}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>{platform}</span>
    </p>

    <h3 class="item-title mt-1.5">
      <a href={href} class="stretched">{title}</a>
    </h3>

    <p class="text-dim mt-1.5 line-clamp-2 text-[0.8125rem] leading-relaxed">{summary}</p>

    <ul class="mt-auto flex flex-wrap gap-x-2 gap-y-0.5 pt-3">
      {
        severity && (
          <li>
            <SeverityTag severity={severity} />
          </li>
        )
      }
      {
        reward && (
          <li>
            <RewardTag reward={reward} />
          </li>
        )
      }
      {
        tags.map((tag) => (
          <li>
            <Tag name={tag} />
          </li>
        ))
      }
    </ul>
  </div>
</article>
