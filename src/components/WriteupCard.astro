---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import SeverityTag from './SeverityTag.astro';
import RewardTag from './RewardTag.astro';
import Icon from './Icon.astro';
import { formatDate, isoDate, slugifyTag } from '../lib/format';
import { readingTimeOf, slugOf, type Writeup } from '../lib/writeups';
import { localeHref, t, type Locale } from '../i18n';

interface Props {
  entry: Writeup;
  lang: Locale;
  number: number;
}

const { entry, lang, number } = Astro.props;
const s = t(lang);
const { title, summary, pubDate, tags, platform, difficulty, severity, reward, cover, coverAlt } =
  entry.data;
const minutes = readingTimeOf(entry);
const href = localeHref(lang, `/writeups/${slugOf(entry)}`);
const caseId = `#${String(number).padStart(3, '0')}`;
const search = [title, summary, platform, severity, reward, ...tags].filter(Boolean).join(' ');
---

<article
  class="group corners corners-hover panel hover:border-hush/40 relative grid gap-5 p-3 transition-colors sm:grid-cols-[220px_minmax(0,1fr)] sm:p-4"
  data-writeup
  data-tags={tags.map(slugifyTag).join(' ')}
  data-search={search.toLowerCase()}
>
  <div class="border-rule bg-raise relative aspect-[16/10] overflow-hidden border">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[320, 480]}
          sizes="(min-width: 640px) 220px, 100vw"
          class="h-full w-full object-cover opacity-80 grayscale-[35%] transition duration-300 group-hover:scale-[1.03] group-hover:opacity-100 group-hover:grayscale-0"
        />
      ) : (
        <div class="grid-bg flex h-full w-full items-center justify-center opacity-60">
          <span class="jp text-hush text-[22px]">{s.railWriteups}</span>
        </div>
      )
    }
    <span
      class="bg-void/85 text-ink absolute top-2 left-2 px-1.5 py-0.5 font-mono text-[10.5px] tracking-[0.08em]"
    >
      {caseId}
    </span>
  </div>

  <div class="flex min-w-0 flex-col py-0.5">
    <div class="meta flex flex-wrap items-center gap-x-2 gap-y-1">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate, lang)}</time>
      <span class="slash" aria-hidden="true">/</span>
      <span>{minutes} {s.readingTime}</span>
      <span class="slash" aria-hidden="true">/</span>
      <span class="text-dim">{platform}</span>
      {
        difficulty && (
          <>
            <span class="slash" aria-hidden="true">
              /
            </span>
            <span>{difficulty}</span>
          </>
        )
      }
    </div>

    <h3
      class="text-ink group-hover:text-blood mt-2 text-[19px] leading-snug font-medium tracking-[-0.02em] text-balance transition-colors"
    >
      <a href={href} class="stretched">{title}</a>
    </h3>

    <p class="text-dim mt-2 line-clamp-2 text-[14px] leading-relaxed">{summary}</p>

    <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-4">
      <ul class="flex flex-wrap gap-1.5">
        {
          severity && (
            <li>
              <SeverityTag severity={severity} />
            </li>
          )
        }
        {
          reward && (
            <li>
              <RewardTag reward={reward} />
            </li>
          )
        }
        {
          tags.map((tag) => (
            <li>
              <Tag name={tag} />
            </li>
          ))
        }
      </ul>
      <Icon
        name="arrow"
        class="text-hush group-hover:text-blood h-4 w-4 -rotate-45 transition duration-200 group-hover:rotate-0"
      />
    </div>
  </div>
</article>
